{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "required": [
        "pihole"
    ],
    "properties": {
        "image": {
            "type": "object",
            "required": [
                "repository",
                "pullPolicy"
            ],
            "properties": {
                "repository": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string",
                    "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                    ]
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "timezone": {
            "type": "string"
        },
        "replicas": {
            "type": "integer",
            "minimum": 0
        },
        "strategy": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "Recreate",
                        "RollingUpdate"
                    ]
                },
                "rollingUpdate": {
                    "type": "object",
                    "properties": {
                        "maxSurge": {
                            "oneOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "string"
                                }
                            ]
                        },
                        "maxUnavailable": {
                            "oneOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "string"
                                }
                            ]
                        }
                    }
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations to add to the pod. Useful for secret injection like Vault, AWS Secrets Manager, etc."
        },
        "extraEnv": {
            "type": "array",
            "description": "Extra environment variables to append to the container",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "valueFrom": {
                        "type": "object"
                    }
                },
                "required": ["name"]
            }
        },
        "pihole": {
            "type": "object",
            "properties": {
                "lists": {
                    "type": "object",
                    "properties": {
                        "adlists": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "address": {
                                        "type": "string"
                                    },
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "comment": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "address"
                                ]
                            }
                        },
                        "whitelist": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "domain": {
                                        "type": "string"
                                    },
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "comment": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "domain"
                                ]
                            }
                        },
                        "blacklist": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "domain": {
                                        "type": "string"
                                    },
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "comment": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "domain"
                                ]
                            }
                        },
                        "regex_whitelist": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "domain": {
                                        "type": "string"
                                    },
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "comment": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "domain"
                                ]
                            }
                        },
                        "regex_blacklist": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "domain": {
                                        "type": "string"
                                    },
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "comment": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "domain"
                                ]
                            }
                        }
                    }
                },
                "web": {
                    "type": "object",
                    "properties": {
                        "password": {
                            "type": "string"
                        },
                        "passwordSecretKey": {
                            "type": "string"
                        },
                        "existingSecret": {
                            "type": "string"
                        }
                    }
                },
                "ftl": {
                    "type": "object",
                    "properties": {
                        "dns": {
                            "type": "object",
                            "required": [
                                "upstreams"
                            ],
                            "properties": {
                                "upstreams": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "minItems": 1
                                },
                                "listeningMode": {
                                    "type": "string",
                                    "enum": [
                                        "ALL",
                                        "LOCAL",
                                        "SINGLE",
                                        "BIND"
                                    ]
                                },
                                "port": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 65535
                                },
                                "queryLogging": {
                                    "type": "boolean"
                                },
                                "dnssec": {
                                    "type": "boolean"
                                },
                                "blocking": {
                                    "type": "object",
                                    "properties": {
                                        "active": {
                                            "type": "boolean"
                                        },
                                        "mode": {
                                            "type": "string",
                                            "enum": [
                                                "NULL",
                                                "IP",
                                                "NX",
                                                "NODATA",
                                                "IP_NODATA_AAAA"
                                            ]
                                        },
                                        "edns": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "cache": {
                                    "type": "object",
                                    "properties": {
                                        "size": {
                                            "type": "integer",
                                            "minimum": 0
                                        }
                                    }
                                }
                            }
                        },
                        "ntp": {
                            "type": "object"
                        },
                        "webserver": {
                            "type": "object",
                            "properties": {
                                "port": {
                                    "type": "string"
                                },
                                "domain": {
                                    "type": "string"
                                }
                            }
                        },
                        "dhcp": {
                            "type": "object",
                            "properties": {
                                "active": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "database": {
                            "type": "object"
                        },
                        "resolver": {
                            "type": "object"
                        },
                        "files": {
                            "type": "object"
                        },
                        "misc": {
                            "type": "object",
                            "properties": {
                                "privacylevel": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 3
                                }
                            }
                        }
                    }
                },
                "uid": {
                    "type": "integer",
                    "minimum": 0
                },
                "gid": {
                    "type": "integer",
                    "minimum": 0
                },
                "tailFtlLog": {
                    "type": "integer",
                    "enum": [0, 1]
                },
                "ftlCmd": {
                    "type": "string"
                },
                "dnsmasqUser": {
                    "type": "string"
                },
                "additionalPackages": {
                    "type": "string"
                },
                "verbose": {
                    "type": "integer",
                    "enum": [0, 1]
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "annotations": {
                    "type": "object"
                }
            }
        },
        "networking": {
            "type": "object",
            "properties": {
                "hostNetwork": {
                    "type": "boolean"
                }
            }
        },
        "serviceDns": {
            "type": "object",
            "required": [
                "enabled",
                "type"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "splitTcpUdp": {
                    "type": "boolean"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "ClusterIP",
                        "NodePort",
                        "LoadBalancer"
                    ]
                },
                "externalTrafficPolicy": {
                    "type": "string",
                    "enum": [
                        "Local",
                        "Cluster"
                    ]
                },
                "annotations": {
                    "type": "object"
                },
                "ports": {
                    "type": "object",
                    "properties": {
                        "tcp": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        },
                        "udp": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        }
                    }
                },
                "loadBalancerIP": {
                    "type": "string"
                },
                "externalIPs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "nodePorts": {
                    "type": "object",
                    "properties": {
                        "tcp": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                        },
                        "udp": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                        }
                    }
                },
                "tcp": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "type": {
                            "type": "string",
                            "enum": [
                                "ClusterIP",
                                "NodePort",
                                "LoadBalancer"
                            ]
                        },
                        "externalTrafficPolicy": {
                            "type": "string",
                            "enum": [
                                "Local",
                                "Cluster"
                            ]
                        },
                        "annotations": {
                            "type": "object"
                        },
                        "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        },
                        "loadBalancerIP": {
                            "type": "string"
                        },
                        "externalIPs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "nodePort": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                        }
                    }
                },
                "udp": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "type": {
                            "type": "string",
                            "enum": [
                                "ClusterIP",
                                "NodePort",
                                "LoadBalancer"
                            ]
                        },
                        "externalTrafficPolicy": {
                            "type": "string",
                            "enum": [
                                "Local",
                                "Cluster"
                            ]
                        },
                        "annotations": {
                            "type": "object"
                        },
                        "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        },
                        "loadBalancerIP": {
                            "type": "string"
                        },
                        "externalIPs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "nodePort": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                        }
                    }
                }
            }
        },
        "serviceWeb": {
            "type": "object",
            "required": [
                "enabled",
                "type"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "ClusterIP",
                        "NodePort",
                        "LoadBalancer"
                    ]
                },
                "externalTrafficPolicy": {
                    "type": "string",
                    "enum": [
                        "Local",
                        "Cluster"
                    ]
                },
                "annotations": {
                    "type": "object"
                },
                "ports": {
                    "type": "object",
                    "properties": {
                        "http": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        },
                        "https": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        }
                    }
                },
                "loadBalancerIP": {
                    "type": "string"
                },
                "externalIPs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "nodePorts": {
                    "type": "object",
                    "properties": {
                        "http": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                        },
                        "https": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                        }
                    }
                }
            }
        },
        "serviceDhcp": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "ClusterIP",
                        "NodePort",
                        "LoadBalancer"
                    ]
                },
                "externalTrafficPolicy": {
                    "type": "string",
                    "enum": [
                        "Local",
                        "Cluster"
                    ]
                },
                "annotations": {
                    "type": "object"
                },
                "ports": {
                    "type": "object",
                    "properties": {
                        "dhcp": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        }
                    }
                },
                "loadBalancerIP": {
                    "type": "string"
                },
                "externalIPs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "nodePort": {
                    "type": "integer",
                    "minimum": 30000,
                    "maximum": 32767
                }
            }
        },
        "persistence": {
            "type": "object",
            "properties": {
                "etcPihole": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "accessMode": {
                            "type": "string"
                        },
                        "size": {
                            "type": "string"
                        }
                    }
                },
                "etcDnsmasq": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "metrics": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "type": {
                            "type": "string",
                            "enum": [
                                "ClusterIP",
                                "NodePort",
                                "LoadBalancer"
                            ]
                        },
                        "externalTrafficPolicy": {
                            "type": "string",
                            "enum": [
                                "Local",
                                "Cluster"
                            ]
                        },
                        "annotations": {
                            "type": "object"
                        },
                        "loadBalancerIP": {
                            "type": "string"
                        },
                        "externalIPs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "nodePort": {
                            "type": "integer",
                            "minimum": 30000,
                            "maximum": 32767
                        }
                    }
                },
                "serviceMonitor": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "dashboards": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "label": {
                            "type": "string"
                        },
                        "labelValue": {
                            "type": "string"
                        },
                        "annotations": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "networkPolicy": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "podDisruptionBudget": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "resources": {
            "type": "object"
        },
        "affinity": {
            "type": "object"
        },
        "nodeSelector": {
            "type": "object"
        },
        "tolerations": {
            "type": "array"
        }
    }
}